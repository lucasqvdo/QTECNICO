# Copie este arquivo para .env e preencha os valores reais.
# NUNCA cometa o .env de verdade no Git.

# --- Banco de dados ---
DATABASE_URL=postgres://usuario:senha@host:5432/nome_do_banco

# --- Autenticação ---
# String longa e aleatória. Gere uma com: openssl rand -base64 32
JWT_SECRET=

# --- Seed do usuário inicial (opcional) ---
# Se não definida, o servidor gera uma senha aleatória e imprime no log na primeira execução.
SEED_USER_PASSWORD=

# --- Storage de fotos/assinaturas (Backblaze B2, compatível com S3) ---
# O bucket é PRIVADO: fotos de clientes/atendimentos não ficam acessíveis por link
# direto. O app gera URLs assinadas e temporárias (1h) sob demanda — por isso não
# existe uma variável de "URL pública" aqui.
#
# Painel Backblaze > Buckets > criar bucket (Files in Bucket: Private) >
# Application Keys > Add a New Application Key
#
# STORAGE_ENDPOINT: em Buckets > (seu bucket), copie o "Endpoint" mostrado
#   (ex: https://s3.us-west-004.backblazeb2.com)
# STORAGE_REGION: a parte da região do endpoint acima (ex: us-west-004)
# STORAGE_ACCESS_KEY_ID / STORAGE_SECRET_ACCESS_KEY: geradas em Application Keys
#   (keyID = access key id, applicationKey = secret access key)
# STORAGE_BUCKET_NAME: nome do bucket
STORAGE_ENDPOINT=https://s3.us-west-004.backblazeb2.com
STORAGE_REGION=us-west-004
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=qtecnico-fotos
