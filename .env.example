# Database (PostgreSQL)
# Obrigatório em produção. O banco em memória só é usado quando USE_MOCK_DB=true (desenvolvimento/testes).
DATABASE_URL=

# Autenticação e Segurança
JWT_SECRET=
ALLOWED_ORIGINS=
PUBLIC_APP_URL=
SEED_USER_PASSWORD=

# Envio de E-mails (Recuperação de Senha via Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Envio de E-mails via SMTP (Legado / Opcional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Armazenamento de Fotos e Anexos (S3 / Backblaze B2 / Cloudflare R2)
# Se não configurado, o upload utiliza fallback seguro em data URL
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=

# Faturamento SaaS (Asaas)
PAYMENT_ENV=sandbox
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Backoffice Administrativo (lista de e-mails de super administradores separados por vírgula)
BACKOFFICE_ADMIN_EMAILS=

# Somente desenvolvimento/testes locais. Nunca habilitar em produção.
USE_MOCK_DB=false
